<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Manager</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>Sales Manager</h1>
    <p>Manage your products, customers and sales</p>
</header>

<nav>
    <button onclick="showSection('dashboard')">Dashboard</button>
    <button onclick="showSection('products')">Products</button>
    <button onclick="showSection('customers')">Customers</button>
    <button onclick="showSection('sales')">Sales</button>
</nav>

<main>

    <!-- DASHBOARD -->
    <section id="dashboard" class="section active">

        <h2>Dashboard</h2>

        <div class="cards">

            <div class="card">
                <h3>Today's Sales</h3>
                <p id="todaySales">₹0</p>
            </div>

            <div class="card">
                <h3>Total Sales</h3>
                <p id="totalSales">₹0</p>
            </div>

            <div class="card">
                <h3>Products</h3>
                <p id="productCount">0</p>
            </div>

            <div class="card">
                <h3>Customers</h3>
                <p id="customerCount">0</p>
            </div>

        </div>

    </section>


    <!-- PRODUCTS -->
    <section id="products" class="section">

        <h2>Products</h2>

        <div class="form-box">

            <input
                type="text"
                id="productName"
                placeholder="Product name"
            >

            <input
                type="number"
                id="productPrice"
                placeholder="Selling price"
                min="0"
            >

            <input
                type="number"
                id="productCost"
                placeholder="Cost price"
                min="0"
            >

            <input
                type="number"
                id="productStock"
                placeholder="Stock quantity"
                min="0"
            >

            <button onclick="addProduct()">Add Product</button>

        </div>

        <div id="productList"></div>

    </section>


    <!-- CUSTOMERS -->
    <section id="customers" class="section">

        <h2>Customers</h2>

        <div class="form-box">

            <input
                type="text"
                id="customerName"
                placeholder="Customer name"
            >

            <input
                type="tel"
                id="customerPhone"
                placeholder="Phone number"
            >

            <button onclick="addCustomer()">Add Customer</button>

        </div>

        <div id="customerList"></div>

    </section>


    <!-- SALES -->
    <section id="sales" class="section">

        <h2>Add Sale</h2>

        <div class="form-box">

            <label>Customer</label>

            <select id="saleCustomer">
                <option value="">Select customer</option>
            </select>


            <label>Product</label>

            <select
                id="saleProduct"
                onchange="updateSaleAmount()"
            >
                <option value="">Select product</option>
            </select>


            <label>Quantity</label>

            <input
                type="number"
                id="saleQuantity"
                value="1"
                min="1"
                onchange="updateSaleAmount()"
                oninput="updateSaleAmount()"
            >


            <label>Total Amount</label>

            <input
                type="number"
                id="saleAmount"
                readonly
            >


            <label>Payment</label>

            <select id="salePayment">
                <option value="paid">Paid</option>
                <option value="unpaid">Unpaid</option>
            </select>


            <button onclick="addSale()">Save Sale</button>

        </div>

        <h2>Sales History</h2>

        <div id="salesList"></div>

    </section>

</main>

<script src="script.js"></script>

</body>
</html>
